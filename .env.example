# Self-hosted OpenAI-compatible inference (Ollama / vLLM / TGI / llama.cpp)
# Ollama default:  http://127.0.0.1:11434/v1
# vLLM default:    http://127.0.0.1:8001/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=not-needed
# OpenBMB MiniCPM-V 4.6 — Chinese multimodal (chat + vision) for CPU-friendly hosts
# Requires Ollama ≥ 0.30. Pull: ollama pull openbmb/minicpm-v4.6
LLM_MODEL=openbmb/minicpm-v4.6
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=240
# Must be > prompt size (PDFs/images). Ollama often defaults to 4096.
LLM_NUM_CTX=16384
OLLAMA_CONTEXT_LENGTH=16384

# Durable state: omit DATABASE_URL to use in-memory checkpointer (dev)
# Compose Postgres: postgresql://postgres:postgres@postgres:5432/ai_coworker
DATABASE_URL=

# MCP servers (HTTP). Leave empty to run without remote tools.
MCP_GITHUB_URL=
MCP_GITHUB_TOKEN=
MCP_CI_URL=
MCP_CI_TOKEN=

# API
API_HOST=0.0.0.0
API_PORT=8000

# Runtime prompt injection (optional)
PROMPTS_PERSIST_PATH=
PROMPTS_ADMIN_TOKEN=

# Keep tracing off unless you host your own observability stack
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-coworker
